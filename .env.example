# 复制为 .env（gitignored）。这里只放机密与进程绑定；
# 非机密配置见 config/wetag.env 与 config/workspaces/<WORKSPACE_ID>.yaml，
# 全部可调参数见 config/properties.py。

# --- 进程绑定的 workspace（一个 workspace 一个进程）---
WORKSPACE_ID=demo

# --- LLM（任意 OpenAI 兼容端点）---
API_KEY=
# BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# --- 企业微信智能机器人 ---
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# --- 启用的外部集成（tapd / lark / wecom），只用企微时写 wecom ---
INTEGRATIONS=tapd,lark,wecom

# --- PostgreSQL ---
# docker compose 用它建业务线角色 wetag_ws_<WORKSPACE_ID> 并拼 PG_DSN
WS_DB_PASSWORD=
# 业务线专属角色：连接串中不存在访问他人 schema 的权限
PG_DSN=postgresql://wetag_ws_demo:***@localhost:5432/wetag
# 仅 scripts/init_workspace.py 与集成测试使用，生产进程不要配置
PG_ADMIN_DSN=

# --- 外部集成凭据（只注入当前 workspace 的一组）---
LARK_CLI_TOKEN=
# 官方 tapd-cli：https://cnb.cool/tapd.cn/skills/tapd-cli
TAPD_TOKEN=
TAPD_API_ENDPOINT=https://api.tapd.cn
# 评论 / 建单的默认署名（可选）
TAPD_NPC_ROLE=
# 拼 TAPD 网页链接
TAPD_WEB_BASE=https://www.tapd.cn
