# WeTag 非机密默认配置（committed）。机密（密钥/token/密码）一律放 .env（gitignored）。
# 优先级：进程环境变量 > .env > config/workspaces/<WORKSPACE_ID>.yaml > 本文件 > 代码默认值

WORKSPACE_ID=demo

# --- PostgreSQL（本地开发库，无敏感性；生产 DSN 放 .env）---
PG_DSN=postgresql://postgres:postgres@localhost:5432/wetag
PG_POOL_SIZE=10

# --- 运行时 ---
WETAG_HTTP_PORT=8080
LLM_MAX_CONCURRENCY=4
JOB_CRON_DOC_POLL="*/3 * * * *"
SESSION_WINDOW_ENFORCE=true

# --- LLM（任意 OpenAI 兼容端点）---
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_STREAM=false
